{
  "name": "padel-net-admin-dashboard",
  "version": "2.0.2",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint ./src/* --fix",
    "lint:ci": "eslint ./src/*",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "types-generate-web-api": "curl -o src/lib/webApi/openapi.json https://admin-api.padel-net.com.ua/swagger/v1/swagger.json && orval --config ./orval.web-api.config.ts",
    "nodecheck": "node -e \"const fs=require('fs');const want=fs.readFileSync('./.nvmrc','utf8').trim().replace(/^v/,'').split('.')[0];const got=process.versions.node.split('.')[0];if(want!==got){console.error('ERROR: Project requires Node v'+want+'.x, but running v'+process.versions.node);process.exit(1);}\"",
    "lint:typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.19",
    "@fullcalendar/daygrid": "^6.1.19",
    "@fullcalendar/interaction": "^6.1.19",
    "@fullcalendar/list": "^6.1.19",
    "@fullcalendar/react": "^6.1.19",
    "@fullcalendar/timegrid": "^6.1.19",
    "@hookform/resolvers": "^5.2.2",
    "@react-jvectormap/core": "^1.0.4",
    "@react-jvectormap/world": "^1.1.2",
    "@sanity/color-input": "^5.0.1",
